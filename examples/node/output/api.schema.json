{
  "dialect": "postgres",
  "defaultRows": 8,
  "tables": [
    {
      "name": "product",
      "rows": 8,
      "columns": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "sku",
          "type": "word"
        },
        {
          "name": "name",
          "type": "word"
        },
        {
          "name": "price",
          "type": "price"
        },
        {
          "name": "stock",
          "type": "number"
        },
        {
          "name": "available",
          "type": "boolean"
        },
        {
          "name": "category",
          "type": "enum:Electronics|Books|Clothing|Sports"
        },
        {
          "name": "created_at",
          "type": "timestamp"
        }
      ]
    },
    {
      "name": "customer",
      "rows": 8,
      "columns": [
        {
          "name": "id",
          "type": "uuid"
        },
        {
          "name": "email",
          "type": "email"
        },
        {
          "name": "first_name",
          "type": "word"
        },
        {
          "name": "last_name",
          "type": "word"
        },
        {
          "name": "phone",
          "type": "word"
        },
        {
          "name": "created_at",
          "type": "timestamp"
        }
      ]
    }
  ]
}