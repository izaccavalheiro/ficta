{
  "name": "ficta",
  "version": "1.2.0",
  "type": "module",
  "main": "./src/node.js",
  "types": "./index.d.ts",
  "browser": "./dist/ficta.browser.js",
  "exports": {
    ".": {
      "node": "./src/node.js",
      "browser": "./dist/ficta.esm.js",
      "default": "./src/node.js"
    },
    "./browser": "./src/browser.js",
    "./core": "./src/core.js",
    "./node": "./src/node.js",
    "./schema-builder": "./src/schema-builder.js",
    "./factory": "./src/factory.js",
    "./schema": "./ficta-schema.v1.json"
  },
  "bin": {
    "ficta": "./cli.js"
  },
  "files": [
    "src/",
    "dist/",
    "cli.js",
    "index.d.ts",
    "browser.d.ts",
    "ficta-schema.v1.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fake-data",
    "test-data",
    "faker",
    "mock-data",
    "csv-generator",
    "data-generator",
    "test-data-generator",
    "json-generator",
    "xml-generator",
    "excel-generator",
    "sql-generator",
    "yaml-generator",
    "toml-generator",
    "cli",
    "browser",
    "nodejs"
  ],
  "author": "Izac Cavaheiro <izac@izaccavalheiro.com>",
  "license": "ISC",
  "description": "Universal test data generator for Node.js, browsers, and CLI. Generate realistic test data in multiple formats (CSV, JSON, XML, Excel, TSV, SQL, YAML, TOML) using Faker.js.",
  "homepage": "https://github.com/izaccavalheiro/ficta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izaccavalheiro/ficta.git"
  },
  "bugs": {
    "url": "https://github.com/izaccavalheiro/ficta/issues"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@iarna/toml": "^2.2.5",
    "@inquirer/prompts": "^8.3.0",
    "js-yaml": "^4.1.1",
    "xml2js": "^0.6.2",
    "yargs": "^18.0.0"
  },
  "optionalDependencies": {
    "exceljs": "^4.4.0",
    "graphql": "^16.12.0",
    "parquetjs-lite": "^0.8.7"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "c8": "^10.1.3",
    "csv-parse": "^6.1.0",
    "esbuild": "^0.27.3",
    "jest": "^30.2.0",
    "preact": "^10.28.4",
    "vitest": "^4.0.18"
  }
}
